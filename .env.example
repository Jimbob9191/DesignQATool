# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Public origin of the app. Every link in outgoing email (signup confirmation,
# password reset, invites, notifications) is built from this, so in production
# it must be the real deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend) — see "Email" in README.md.
# Without RESEND_API_KEY nothing is sent; in development the email (including
# its confirm/reset link) is printed to the server console instead.
RESEND_API_KEY=
# Sender on a domain verified in Resend. Unset falls back to Resend's sandbox
# sender, which only delivers to the Resend account owner's own address.
EMAIL_FROM="DesignParity.app <no-reply@mail.designparity.app>"
# Optional: where replies go.
EMAIL_REPLY_TO=

# PDF export service (optional) — see "PDF export service" in README.md
CAPTURE_SERVICE_URL=
CAPTURE_SERVICE_SECRET=

# Live-preview proxy (optional) — see "Live site comparisons" in README.md.
# Locally, run live-proxy/ (`cd live-proxy && npm run dev`) and use:
#   LIVE_PROXY_DOMAIN=proxy.localhost:8788
# In production, the Worker's domain, e.g. dpproxy.com.
LIVE_PROXY_DOMAIN=
# Shared with the proxy (its PROXY_SECRET); 16+ characters.
LIVE_PROXY_SECRET=
